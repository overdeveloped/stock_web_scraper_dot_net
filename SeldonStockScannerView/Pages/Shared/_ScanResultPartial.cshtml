@using SeldonStockScannerView.Models
@model IEnumerable<FinvizCompanyModel>

@foreach (var company in Model)
{
    <tr>
        <td>@company.Ticker</td>
        <td>@company.Company</td>
        <td>@company.Sector</td>
        <td>@company.Industry</td>
        <td>@company.Country</td>
        <td>@company.MarketCap</td>
        <td>@company.Pe</td>
        <td>@company.Price</td>
        <td>@company.Change</td>
        <td>@company.Volume</td>
        <td>
            @* <form method="POST" action="/api/watchlist"></form> *@
            @* <input type="hidden" name="ticker" value="@company.Ticker"/> *@
            @* <button class="btn btn-primary btn-sm view-btn" data-id="@company.Ticker">Save</button> *@
            @* <button type="submit" class="btn btn-primary btn-sm view-btn">Save</button> *@
            <button id="openWatchModal" class="btn btn-primary btn-sm view-btn" data-row-id="@company.Id">Save</button>
        </td>
    </tr>
}
