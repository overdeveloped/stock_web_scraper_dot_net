                   break;
                case "7":
                   endpoint = "shorts";
                   break;
                case "8":
                   endpoint = "shortsqueeze";
                   break;
                case "9":
                   endpoint = "bouncema";
                   break;
            }

            if (selected != "")
            {
                $.ajax({
                    // url: `https://localhost:7059/api/Finviz/` + endpoint,
                    url: "?handler=Scan&endpoint=" + endpoint,
                    method: "GET",
                    // contentType: 'application/json',
