@page
@using SeldonStockScannerView.Models
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    List<FinvizCompanyModel> companies = (List<FinvizCompanyModel>)ViewData["companies"];

}

<div class="text-center">
    <h1 class="display-4">Scanner</h1>

    <span>
        <select asp-for="scanType" id="scanType" name="scanType">
            <option value=""> select a scan </option>
            <option value="0"> GetMegaCompanies </option>
            <option value="1"> GetTech </option>
            <option value="2"> GetLongHolds </option>
            <option value="3"> GetOversoldBounce </option>
            <option value="4"> GetBreakout </option>
            <option value="5"> GetBreakoutV2 </option>
            <option value="6"> ForteCapitalDayTrading </option>
            <option value="7"> GetShorts </option>
            <option value="8"> GetShortSqueezes </option>
            <option value="9"> GetBounceOffMa </option>
        </select>

        @* <form asp-page-handler="Scan" method="get"> *@
        @* <button id="buttScan">SCAN</button> *@
        @* </form> *@
        <button id="buttScan">SCAN</button>

        @* <a asp-page-handler="Scan" class="btn btn-primary">Scan</a> *@

    </span>

    <table id="scanTable">
        <thead>
            <tr>
                <th>ticker</th>
                <th>company</th>
                <th>sector</th>
                <th>industry</th>
                <th>country</th>
                <th>marketCap</th>
                <th>pe</th>
                <th>price</th>
                <th>change</th>
                <th>volume</th>
                <th>Watch List</th>
            </tr>
        </thead>

        <tbody id="scanBody">



            @*             @{
                if (companies != null)
                {
                    foreach (FinvizCompany company in companies)
                    {
                        <tr>
                            <td>@company.Ticker</td>
                            <td>@company.Company</td>
                            <td>@company.Sector</td>
                            <td>@company.Industry</td>
                            <td>@company.Country</td>
                            <td>@company.MarketCap</td>
                            <td>@company.Pe</td>
                            <td>@company.Price</td>
                            <td>@company.Change</td>
                            <td>@company.Volume</td>
                        </tr>
                    }
                }
            }
 *@        </tbody>
    </table>

</div>

<div id="modalWatch" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add to Watch List</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>





            <form method="post">
                <input type="hidden" id="ModalTicker" name="Ticker"/>

@*                     <select id="watchLists" class="form-control">
                        <option value="">Select watch list</option>
                    </select>
 *@             <div class="modal-body">
                    <!-- Select box will load here -->
                    <select asp-for="SelectedWatchListId" asp-items="Model.WatchLists" class="form-select">
                        <option value="">Select One</option>
                    </select>
                    <p>Loading...</p>
                </div>



                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>

            </form>





        </div>
    </div>
</div>


@section scripts
{
    <script>

        document.getElementById('modalWatch')
            .addEventListener('show.bs.modal', async function (event) {

                const button = event.relatedTarget; // ← the clicked button
                const ticker = button.getAttribute('data-row-ticker');

                const response = await fetch(`/api/FinvizCompany/by-ticker/${ticker}`)
                const company = await response.json();

                // Store row Ticker in hidden field
                document.getElementById('ModalTicker').value = ticker;
                window.selectedCompany = company;

                console.log("Modal opened for row:", ticker);
                console.log("Modal opened for company:", company);
            });


        $("#buttScan").on("click", function () {
            const selected = $("#scanType").val();
            let endpoint = "";
            console.log(selected);

            switch (selected)
            {
                case "0":
                    endpoint = "megacompanies";
                    break;
                case "1":
                   endpoint = "tech";
                   break;
                case "2":
                   endpoint = "longholds";
                   break;
                case "3":
                   endpoint = "oversoldbounce";
                   break;
                case "4":
                   endpoint = "breakout";
                   break;
                case "5":
                   endpoint = "breakoutv2";
                   break;
                case "6":
