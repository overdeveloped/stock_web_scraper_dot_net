@model IEnumerable<SeldonStockScannerView.Models.WatchList>

@{
    ViewBag.Title = "Product Cards";
}


<h2>Watch List</h2>

<table>
    <tr>
        <th>Name</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.WatchListName</td>
            <td>0
                @Html.ActionLink("Edit", "Edit", new { id = item.WatchListId }) |
                @Html.ActionLink("Details", "Details", new { id = item.WatchListId }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.WatchListId })
            </td>
        </tr>
    }
</table>



<div class="row">
    @foreach (var w in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@w.WatchListName</h5>
                    <p class="card-text">Product ID: @w.WatchListId</p>

                    <a href="#" class="btn btn-primary">View</a>
                </div>
            </div>
        </div>
    }
</div>

