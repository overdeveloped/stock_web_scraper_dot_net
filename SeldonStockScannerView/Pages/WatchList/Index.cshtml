@page "/WatchLists"
@model IndexModel

<h2>Products</h2>

<a asp-page="Create" class="btn btn-primary">Create New</a>

<table class="table mt-3">
    <tr>
        <th>Name</th>
        <th></th>
    </tr>

    @foreach (var w in Model.WatchLists)
    {
        <tr>
            <td>@w.WatchListName</td>
            <td>
                <a asp-page="Edit" asp-route-id="@w.WatchListId">Edit</a> |
                <a asp-page="Details" asp-route-id="@w.WatchListId">Details</a> |
                <a asp-page="Delete" asp-route-id="@w.WatchListId">Delete</a>
            </td>
        </tr>
    }
</table>
