@page
@* @model IEnumerable<SeldonStockScannerView.Models.WatchList> *@
@model WatchList.IndexModel

<h2>Products</h2>

<a asp-page="Create" class="btn btn-primary">Create New</a>

<table class="table mt-3">
    <tr>
        <th>Name</th>
        <th>Price</th>
        <th></th>
    </tr>

    @foreach (var w in Model)
    {
        <tr>
            <td>@w.</td>
            <td>@p.Price</td>
            <td>
                <a asp-page="Edit" asp-route-id="@p.Id">Edit</a> |
                <a asp-page="Details" asp-route-id="@p.Id">Details</a> |
                <a asp-page="Delete" asp-route-id="@p.Id">Delete</a>
            </td>
        </tr>
    }
</table>
